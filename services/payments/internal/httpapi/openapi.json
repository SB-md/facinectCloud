{
  "openapi": "3.0.3",
  "info": {
    "title": "Facinect Payments API",
    "version": "1.0.0",
    "description": "Phase 1: payment ledger, summary, record payment, mark paid."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/v1/payments/health": {
      "get": { "summary": "Health", "responses": { "200": { "description": "OK" } } }
    },
    "/v1/payments/facilities/{facilityId}/ledger": {
      "get": {
        "summary": "Payment ledger",
        "parameters": [
          { "name": "facilityId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "ledger[]" } }
      }
    },
    "/v1/payments/facilities/{facilityId}/summary": {
      "get": {
        "summary": "Ledger summary totals",
        "responses": { "200": { "description": "summary" } }
      }
    },
    "/v1/payments/facilities/{facilityId}/payments": {
      "post": {
        "summary": "Record a ledger entry",
        "responses": { "200": { "description": "Ledger row" } }
      }
    },
    "/v1/payments/facilities/{facilityId}/payments/{paymentId}/mark-paid": {
      "post": {
        "summary": "Mark payment paid/partial",
        "responses": { "200": { "description": "Ledger row" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "serviceKey": { "type": "apiKey", "in": "header", "name": "X-Service-Key" }
    }
  },
  "security": [{ "bearerAuth": [] }, { "serviceKey": [] }]
}
