# Copy to .env for local Docker Compose:
#   cp .env.example .env
# Never commit .env — it holds real secrets.
COMPOSE_PROJECT_NAME=facinect

POSTGRES_IDENTITY_DB=fac_identity
POSTGRES_IDENTITY_USER=identity
POSTGRES_IDENTITY_PASSWORD=identity_local_change_me

REDIS_PASSWORD=

# Identity JWT (RS256) — generate with scripts/generate-jwt-keys.sh
JWT_ISSUER=https://api.facinect.local
JWT_AUDIENCE=facinect-apps
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Local bootstrap admin (created on first boot if missing)
BOOTSTRAP_ADMIN_EMAIL=admin@facinect.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin_123!
BOOTSTRAP_ADMIN_NAME="Facinect Admin"

# Google OAuth — put real values only in .env (not here)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback

# Gateway
TRAEFIK_DASHBOARD=true

# Notifications (WhatsApp + push) — local defaults to dry-run when Meta token empty
NOTIFICATIONS_SERVICE_KEY=
NOTIFICATIONS_DRY_RUN=true
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0
FCM_SERVER_KEY=
