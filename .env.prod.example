# Production / VPS env — copy to .env.prod and fill real values.
#   cp .env.prod.example .env.prod
# Never commit .env.prod
COMPOSE_PROJECT_NAME=facinect

APP_ENV=production

POSTGRES_IDENTITY_DB=fac_identity
POSTGRES_IDENTITY_USER=identity
POSTGRES_IDENTITY_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

REDIS_PASSWORD=

JWT_ISSUER=http://169.58.139.45:8081
JWT_AUDIENCE=facinect-apps
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

BOOTSTRAP_ADMIN_EMAIL=admin@facinect.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME="Facinect Admin"

# Google OAuth — add redirect URI in Google Console:
#   http://169.58.139.45:8081/v1/auth/google/callback
# After domain + HTTPS, switch both to https://portal.yourdomain.com/...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://169.58.139.45:8081/v1/auth/google/callback

CORS_ORIGINS=*

# Host port for Traefik gateway (RoutForge already uses 8080)
FACINECT_HTTP_PORT=8081

# Notifications
NOTIFICATIONS_SERVICE_KEY=CHANGE_ME_NOTIFICATIONS_SERVICE_KEY
NOTIFICATIONS_DRY_RUN=false
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0
FCM_SERVER_KEY=
